# Copy to .env and fill in. Loaded by dotenv at the top of index.js.

# Atlas connection string. Falls back to mongodb://localhost:27017/echoes if unset,
# but Explore needs an Atlas Search vector index ($vectorSearch), which community
# MongoDB does not provide — so a local mongod will not give you a working Explore feed.
MONGO_URI=

# Signing key for the auth JWT. REQUIRED — there is no fallback.
# If this is unset, jwt.sign() in authRoutes.js throws ("secretOrPrivateKey must have
# a value") so login fails, and jwt.verify() in both verifyToken.js and the Socket.IO
# handshake middleware rejects everything. Any long random string works locally.
JWT_SECRET=

PORT=5000
NODE_ENV=development

# Cloudinary — image uploads (middleware/cloudinaryConfig.js).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Same Google OAuth Client ID as the client's VITE_GOOGLE_CLIENT_ID.
# Used server-side to verify the Google ID token in authRoutes.js — never trust the
# client's claim, so both sides need it.
GOOGLE_CLIENT_ID=

# Required — utils/redisClient.js throws on boot if this is unset. Powers the
# Socket.IO cross-instance adapter, the user-profile cache, and auth rate limiting.
# Local: install Redis (or `docker run -p 6379:6379 redis`) and use redis://localhost:6379
# Cloud (no local install needed): a free-tier rediss://... URL from Upstash or Redis Cloud.
REDIS_URL=

# Optional. Co-presence feature kill switch — set to the literal string "false" to
# disable the feature everywhere (routes return 503, the scheduled candidate job
# no-ops) with no deploy required. Defaults to enabled when unset.
COPRESENCE_ENABLED=

# Optional. How often (in milliseconds) the co-presence candidate job runs — see
# queues/coPresenceCandidateQueue.js. Defaults to 3600000 (1 hour) when unset.
COPRESENCE_JOB_INTERVAL_MS=
