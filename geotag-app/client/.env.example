# Copy to .env and fill in. Vite only exposes vars prefixed with VITE_.
# Restart `npm run dev` after any change — Vite reads .env at server start, not per request.

# API origin. Every call falls back to http://localhost:5000 if this is unset,
# which is why the app mostly works locally without a .env — but OAuth does not.
VITE_BASE_URL=http://localhost:5000

# Google OAuth 2.0 Client ID (the "...apps.googleusercontent.com" one).
# No fallback exists for this — if it is unset, Google rejects the sign-in with
# "Error 400: invalid_request — Missing required parameter: client_id".
# The Client ID's "Authorized JavaScript origins" must include http://localhost:5173
# for local dev, or Google returns origin_mismatch instead.
VITE_GOOGLE_CLIENT_ID=
